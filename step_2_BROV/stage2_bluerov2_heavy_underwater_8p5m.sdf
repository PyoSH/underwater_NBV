<?xml version='1.0' encoding='UTF-8'?>
<sdf version="1.6">
  <world name="bluerov2_heavy_underwater">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <plugin filename="gz-sim-buoyancy-system"
            name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1.225</density>
        </density_change>
      </graded_buoyancy>
      <enable>bluerov2_heavy</enable>
    </plugin>

    <scene>
      <ambient>0.6 0.6 0.7 1</ambient>
      <background>0.1 0.2 0.35 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.6 0.6 0.6 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="seabed">
      <static>true</static>
      <pose>0 0 -10 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.6 0.55 0.4 1</ambient>
            <diffuse>0.6 0.55 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="water_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.5 0.6</ambient>
            <diffuse>0.1 0.3 0.5 0.6</diffuse>
            <transparency>0.4</transparency>
          </material>
        </visual>
      </link>
    </model>

    <!-- Case-A A/B starts at 8.80 m depth.  This preserves bottom clearance
         while keeping the positive-buoyancy startup and 0.20 m dive inside
         the Water Linked mode-1 altitude band (0.3--3.0 m). -->
    <include>
      <pose degrees="true">0 0 -8.8 0 0 0</pose>
      <uri>model://bluerov2_heavy</uri>
    </include>

    <!-- Fixed observer camera for offline video recording of Case-A runs
         (policy vs. model-based causal-isolation review). Positioned to
         frame the vehicle's operating volume (roughly z=-6..-8.8, x/y
         within a few m of the spawn point) regardless of the mission's
         world-frame heading. Rendering works headless via Mesa software
         fallback in this container (no /dev/dri access) -- confirmed by
         empirical test, ~10 Hz is affordable. -->
    <model name="observer_camera">
      <static>true</static>
      <pose>4 -4 -5 0 0.377 2.229</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.4</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <visualize>false</visualize>
          <topic>observer_camera/image</topic>
        </sensor>
      </link>
    </model>

    <!-- Second fixed camera for Case-C (5 m square, random-attitude-per-
         corner) runs -- Case-A's camera above only frames the small 2 m
         line near the spawn point, not the 5x5 m square. Pose derived from
         a real probe run's /brov/sim/gazebo_odometry_raw range (x:[0,5.0],
         y:[-5.0,0], z:[-8.46,-5.55], centroid (1.51,-1.42,-6.46)) using the
         same diagonal-elevated-lookat convention as observer_camera above,
         scaled for the larger path. -->
    <model name="observer_camera_c">
      <static>true</static>
      <pose>1.51 -1.42 -1.5 0 1.4 0</pose>
      <link name="link">
        <sensor name="camera" type="camera">
          <camera>
            <horizontal_fov>1.4</horizontal_fov>
            <image>
              <width>640</width>
              <height>480</height>
            </image>
            <clip>
              <near>0.1</near>
              <far>100</far>
            </clip>
          </camera>
          <always_on>true</always_on>
          <update_rate>5</update_rate>
          <visualize>false</visualize>
          <topic>observer_camera_c/image</topic>
        </sensor>
      </link>
    </model>
  </world>
</sdf>
