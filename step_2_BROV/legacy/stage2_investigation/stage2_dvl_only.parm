# Stage-2 Gazebo SITL estimator contract matching the real DVL-only BROV.
#
# The Water Linked BlueOS extension supplies body-frame displacement via
# MAVLink VISION_POSITION_DELTA.  EKF3 fuses that ExternalNav velocity with
# the SITL IMU/AHRS, compass and pressure/barometer.  Simulated GPS is both
# disabled at the sensor and excluded from EKF source selection.
AHRS_EKF_TYPE 3
EK2_ENABLE 0
EK3_ENABLE 1
VISO_TYPE 1
EK3_SRC1_POSXY 6
EK3_SRC1_VELXY 6
EK3_SRC1_POSZ 1
EK3_SRC1_VELZ 0
EK3_SRC1_YAW 1
VISO_DELAY_MS 100
VISO_ORIENT 0
VISO_POS_X 0
VISO_POS_Y 0
VISO_POS_Z 0
SIM_GPS_DISABLE 1
GPS1_TYPE 0
GPS2_TYPE 0
