<?xml version='1.0' encoding='UTF-8'?>
<!-- 실수조 모사 world: 6(Y) x 10(X) x 3 m, 수면 2.7 m.  2026-09-10.
     stage2_bluerov2_heavy_underwater_8p5m.sdf 의 플러그인/부력 설정을 계승하고
     지형만 교체한다.  기하 상수는 DEPLOY_3WEEK_PLAN.md §12.0 참조.

     수면은 z=0 으로 고정한다 — graded_buoyancy 의 above_depth 0 이 그 정의이고,
     바닥을 -2.7 로 내려 "수심 2.7 m" 를 만든다. 수조 구조물은 +0.3 까지.
     NBV 구면 중심 = plaster_mold 모델 원점 = (0, 0, -2.7). -->
<sdf version="1.6">
  <world name="pool_sweep">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system"           name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-sensors-system"           name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-user-commands-system"     name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-imu-system"               name="gz::sim::systems::Imu"/>

    <plugin filename="gz-sim-buoyancy-system" name="gz::sim::systems::Buoyancy">
      <graded_buoyancy>
        <default_density>1000</default_density>
        <density_change>
          <above_depth>0</above_depth>
          <density>1.225</density>
        </density_change>
      </graded_buoyancy>
      <enable>bluerov2_heavy</enable>
    </plugin>

    <scene>
      <ambient>0.65 0.68 0.72 1</ambient>
      <background>0.08 0.16 0.24 1</background>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.9 0.9 0.9 1</diffuse>
      <specular>0.4 0.4 0.4 1</specular>
      <direction>-0.3 0.2 -0.93</direction>
    </light>

    <!-- ── 수조 구조물: 바닥 상면 z=-2.7, 벽 내부 6(Y) x 10(X), 벽 상단 z=+0.3 ── -->
    <model name="pool">
      <static>true</static>
      <link name="link">
        <collision name="floor">
          <pose>0 0 -2.8 0 0 0</pose>
          <geometry><box><size>10.4 6.4 0.2</size></box></geometry>
        </collision>
        <visual name="floor">
          <pose>0 0 -2.8 0 0 0</pose>
          <geometry><box><size>10.4 6.4 0.2</size></box></geometry>
          <material>
            <ambient>0.55 0.58 0.60 1</ambient>
            <diffuse>0.62 0.66 0.68 1</diffuse>
          </material>
        </visual>

        <collision name="wall_xp"><pose>5.1 0 -1.2 0 0 0</pose>
          <geometry><box><size>0.2 6.4 3.0</size></box></geometry></collision>
        <visual name="wall_xp"><pose>5.1 0 -1.2 0 0 0</pose>
          <geometry><box><size>0.2 6.4 3.0</size></box></geometry>
          <material><ambient>0.70 0.74 0.76 1</ambient><diffuse>0.78 0.82 0.84 1</diffuse></material></visual>

        <collision name="wall_xn"><pose>-5.1 0 -1.2 0 0 0</pose>
          <geometry><box><size>0.2 6.4 3.0</size></box></geometry></collision>
        <visual name="wall_xn"><pose>-5.1 0 -1.2 0 0 0</pose>
          <geometry><box><size>0.2 6.4 3.0</size></box></geometry>
          <material><ambient>0.70 0.74 0.76 1</ambient><diffuse>0.78 0.82 0.84 1</diffuse></material></visual>

        <collision name="wall_yp"><pose>0 3.1 -1.2 0 0 0</pose>
          <geometry><box><size>10.0 0.2 3.0</size></box></geometry></collision>
        <visual name="wall_yp"><pose>0 3.1 -1.2 0 0 0</pose>
          <geometry><box><size>10.0 0.2 3.0</size></box></geometry>
          <material><ambient>0.70 0.74 0.76 1</ambient><diffuse>0.78 0.82 0.84 1</diffuse></material></visual>

        <collision name="wall_yn"><pose>0 -3.1 -1.2 0 0 0</pose>
          <geometry><box><size>10.0 0.2 3.0</size></box></geometry></collision>
        <visual name="wall_yn"><pose>0 -3.1 -1.2 0 0 0</pose>
          <geometry><box><size>10.0 0.2 3.0</size></box></geometry>
          <material><ambient>0.70 0.74 0.76 1</ambient><diffuse>0.78 0.82 0.84 1</diffuse></material></visual>
      </link>
    </model>

    <model name="water_surface">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>10 6</size></plane></geometry>
          <material>
            <ambient>0.10 0.30 0.45 0.5</ambient>
            <diffuse>0.10 0.30 0.45 0.5</diffuse>
          </material>
          <transparency>0.5</transparency>
        </visual>
      </link>
    </model>

    <!-- ── 표적: 바닥 중앙 접지, yaw 45 deg (Isaac _ROT_45Z 재현) ──
         NBV 구면 중심 = 이 모델 원점 = (0, 0, -2.7). -->
    <include>
      <name>plaster_mold</name>
      <pose degrees="true">0 0 -2.7 0 0 45</pose>
      <uri>model://plaster_mold</uri>
    </include>

    <!-- ── 마커: rim 상단(로컬 z=0.933) 위, 물체와 같은 yaw ──
         모델 원점 z = -2.7 + 0.933 = -1.767, 태그면 z = -1.7585
         (= 물체 로컬 0.9415). -->
    <include>
      <name>apriltag_16h5_id2</name>
      <pose degrees="true">0 0 -1.767 0 0 45</pose>
      <uri>model://apriltag_16h5_id2</uri>
    </include>



    <!-- 스윕용 정적 프로브. 시작 위치는 수조 밖(스윕 스크립트가 set_pose 로 옮긴다). -->
    <include>
      <name>nbv_probe_camera</name>
      <pose>0 0 5 0 0 0</pose>
      <uri>model://nbv_probe_camera</uri>
    </include>
  </world>

</sdf>
