<?xml version="1.0"?>
<sdf version="1.9">
  <!-- 시점 스윕용 정적 프로브 카메라. ROV 의 nbv_camera 와 동일한 rgbd_camera 설정.
       모델 원점 = 카메라 광학 중심이므로 set_pose 로 옮긴 pose 가 곧 카메라 pose 다.
       gz 센서 프레임: +X 전방 / +Y 좌 / +Z 상 (ROV 카메라와 같은 규약). -->
  <model name="nbv_probe_camera">
    <static>true</static>
    <link name="link">
      <sensor name="probe" type="rgbd_camera">
        <camera>
          <horizontal_fov>1.204447</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.05</near><far>20.0</far></clip>
        </camera>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <topic>nbv/probe</topic>
      </sensor>
    </link>
  </model>
</sdf>
